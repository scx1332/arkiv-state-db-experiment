         max_map_size: (scenario.database.max_map_size_gib << 30) as usize,
         ..Default::default()
     };
-    let db: Db = Arc::new(Database::open_with_options(dir, &config, options)?);
+    let backend = std::env::var("GOLEMDB_BACKEND").unwrap_or_else(|_| "golemdb".into());
+    let (db, backend_note): (Db, String) = match backend.as_str() {
+        "golemdb" => (
+            Arc::new(Database::open_with_options(dir, &config, options)?),
+            "golem-db (MDBX)".into(),
+        ),
+        "arkiv" | "arkiv-memory" => {
+            let mut opts = arkiv::ArkivOptions {
+                exact_version: false,
+                ..Default::default()
+            };
+            if let Ok(mib) = std::env::var("ARKIV_REDB_CACHE_MIB") {
+                opts.redb_cache = mib.parse::<usize>()? << 20;
+            }
+            if let Ok(mib) = std::env::var("ARKIV_OBJECT_CACHE_MIB") {
+                opts.object_cache = mib.parse::<usize>()? << 20;
+            }
+            if let Ok(n) = std::env::var("ARKIV_OBJECT_CACHE_ENTRIES") {
+                opts.object_cache_entries = n.parse()?;
+            }
+            let db = if backend == "arkiv" {
+                arkiv::ArkivDb::open_durable(dir, &config.genesis, opts)?
+            } else {
+                arkiv::ArkivDb::open_memory(&config.genesis, opts)?
+            };
+            let note = db.description.clone();
+            (Arc::new(db), note)
+        }
+        other => bail!("GOLEMDB_BACKEND must be golemdb, arkiv or arkiv-memory, not {other:?}"),
+    };
 
     println!("{}", scenario.name);
+    println!("  backend: {backend_note}");
     if !scenario.description.is_empty() {
         println!("  {}", scenario.description);
     }
