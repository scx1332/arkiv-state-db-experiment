+/// Without MDBX there are no tables to read: one line per file of the
+/// database directory (4 KiB pages), then their total as `file`.
+fn files(dir: &Path) -> Result<Vec<String>> {
+    let mut sizes = Vec::new();
+    for entry in std::fs::read_dir(dir)? {
+        let entry = entry?;
+        let meta = entry.metadata()?;
+        if meta.is_file() {
+            sizes.push((entry.file_name().to_string_lossy().into_owned(), meta.len()));
+        }
+    }
+    sizes.sort();
+    let total = sizes.iter().map(|(_, bytes)| bytes).sum();
+    sizes.push(("file".to_owned(), total));
+    Ok(sizes
+        .into_iter()
+        .map(|(name, bytes)| {
+            format!("{name},,,{},{:.3}", bytes / 4096, bytes as f64 / (1 << 20) as f64)
+        })
+        .collect())
+}
