+    // Takes what the last durable commit saved, leaving it unknown until the commit under way
+    // records what it saved in turn
+    pub(crate) fn take_saved_allocator_state(&self) -> Option<Vec<Vec<u8>>> {
+        self.saved_allocator_state.lock().unwrap().take()
+    }
+
+    pub(crate) fn set_saved_allocator_state(&self, saved: Option<Vec<Vec<u8>>>) {
+        *self.saved_allocator_state.lock().unwrap() = saved;
+    }
+
+    // The serialized allocator state of every region as it will be once `pending` are freed:
+    // the pages a commit recorded in SYSTEM_FREED_TABLE, which a later commit frees
+    pub(crate) fn serialized_region_allocators_without(
+        &self,
+        pending: &[PageNumber],
+    ) -> Vec<Vec<u8>> {
+        let state = self.state.lock().unwrap();
+        state
+            .allocators()
+            .region_allocators
+            .iter()
+            .enumerate()
+            .map(|(region, allocator)| {
+                let bytes = allocator.to_vec();
+                if !pending.iter().any(|page| page.region as usize == region) {
+                    return bytes;
+                }
+                let mut freed = BuddyAllocator::from_bytes(&bytes);
+                for page in pending.iter().filter(|page| page.region as usize == region) {
+                    freed.free(page.page_index, page.page_order);
+                }
+                freed.to_vec()
+            })
+            .collect()
+    }
+
+    // Brings an allocator-state table that holds `saved` up to date, rewriting only the regions
+    // whose state differs from it. `store_freed` records the pages freed so far; it runs after
+    // every pass that reserved space, as in a full save, so that the snapshot matches the
+    // system root being committed.
+    //
+    // `saved` is what the regions were expected to be by now (see durable_commit()); a region
+    // that matches it is left alone.
+    //
+    // Returns false if the table cannot be updated this way (the number of regions changed, or
+    // the passes did not settle): the caller then clears it and saves everything.
+    pub(crate) fn save_changed_allocator_state(
+        &self,
+        tree: &mut AllocatorStateTreeMut,
+        transaction_id: TransactionId,
+        saved: &[Vec<u8>],
+        mut store_freed: impl FnMut() -> Result,
+    ) -> Result<bool> {
+        // Region -> the length reserved for it in this transaction
+        let mut reserved: Vec<Option<usize>> = vec![None; saved.len()];
+        let mut tracker_reserved: Option<usize> = None;
+        // Each pass that does not settle reserves at least one more region or a longer value
+        let passes = saved.len() + 8;
+        for pass in 0..passes {
+            let (current, tracker) = {
+                let state = self.state.lock().unwrap();
+                if state.header.layout().num_regions() as usize != saved.len() {
+                    return Ok(false);
+                }
+                let allocators = state.allocators();
+                let current: Vec<Vec<u8>> = allocators
+                    .region_allocators
+                    .iter()
+                    .map(BuddyAllocator::to_vec)
+                    .collect();
+                (current, allocators.region_tracker.to_vec())
+            };
+            if current.len() != saved.len() {
+                return Ok(false);
+            }
+
+            let mut changed = false;
+            for (i, bytes) in current.iter().enumerate() {
+                let stale = match reserved[i] {
+                    Some(len) => len != bytes.len(),
+                    None => saved[i] != *bytes,
+                };
+                if stale {
+                    tree.insert(
+                        &AllocatorStateKey::Region(i.try_into().unwrap()),
+                        &vec![0; bytes.len()].as_ref(),
+                    )?;
+                    reserved[i] = Some(bytes.len());
+                    changed = true;
+                }
+            }
+            if tracker_reserved != Some(tracker.len()) {
+                tree.insert(
+                    &AllocatorStateKey::RegionTracker,
+                    &vec![0; tracker.len()].as_ref(),
+                )?;
+                tracker_reserved = Some(tracker.len());
+                changed = true;
+            }
+            if pass == 0 {
+                tree.insert(
+                    &AllocatorStateKey::TransactionId,
+                    &transaction_id.raw_id().to_le_bytes().as_ref(),
+                )?;
+                changed = true;
+            }
+            if changed {
+                // Space was reserved, which allocates and frees: record the freed pages and
+                // look at the allocators again
+                store_freed()?;
+                continue;
+            }
+
+            // Nothing moved since the freed pages were recorded: every region that differs
+            // from the table has space reserved in this transaction
+            for (i, bytes) in current.iter().enumerate() {
+                if reserved[i].is_some() {
+                    tree.insert_inplace(
+                        &AllocatorStateKey::Region(i.try_into().unwrap()),
+                        &bytes.as_ref(),
+                    )?;
+                }
+            }
+            tree.insert_inplace(&AllocatorStateKey::RegionTracker, &tracker.as_ref())?;
+            // A rewritten region holds exactly its state. A region left alone holds a superset
+            // of its allocations (see durable_commit()), so it never has more pages free.
+            #[cfg(debug_assertions)]
+            {
+                let state = self.state.lock().unwrap();
+                let allocators = state.allocators();
+                assert_eq!(allocators.region_allocators.len(), current.len());
+                for (i, allocator) in allocators.region_allocators.iter().enumerate() {
+                    let stored = tree
+                        .get(&AllocatorStateKey::Region(i.try_into().unwrap()))?
+                        .expect("a region entry");
+                    if reserved[i].is_some() {
+                        assert!(
+                            stored.value() == allocator.to_vec().as_slice(),
+                            "allocator state of region {i} differs from the table"
+                        );
+                    } else {
+                        let stored = BuddyAllocator::from_bytes(stored.value());
+                        assert!(
+                            stored.count_allocated_pages() >= allocator.count_allocated_pages(),
+                            "the table has pages of region {i} free that are allocated"
+                        );
+                    }
+                }
+                let stored = tree
+                    .get(&AllocatorStateKey::RegionTracker)?
+                    .expect("the region tracker entry");
+                assert!(stored.value() == allocators.region_tracker.to_vec().as_slice());
+                assert_eq!(
+                    tree.range::<core::ops::RangeFull, AllocatorStateKey>(&(..))?
+                        .count(),
+                    current.len() + 2
+                );
+            }
+            return Ok(true);
+        }
+        Ok(false)
+    }
